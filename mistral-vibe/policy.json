{
  "extends": "default",
  "meta": {
    "name": "mistral-vibe",
    "version": "1.0.0",
    "description": "Mistral Vibe CLI profile (registry-managed)",
    "author": "nolabs-ai"
  },
  "groups": {
    "include": [
      "python_runtime",
      "node_runtime",
      "rust_runtime",
      { "name": "user_caches_macos", "when": "macos" },
      { "name": "user_caches_linux", "when": "linux" },
      { "name": "linux_sysfs_read", "when": "linux" },
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ]
  },
  "security": {
    "signal_mode": "isolated",
    "process_info_mode": null,
    "ipc_mode": null,
    "capability_elevation": false,
    "approval_backends": {},
    "approval_defaults": null,
    "wsl2_proxy_policy": null
  },
  "filesystem": {
    "allow": [
      "$HOME/.vibe",
      "$NONO_CONFIG/profile-drafts",
      "~/.vibe"
    ],
    "allow_file": [
      "~/.vibe"
    ],
    "read": [
      "$HOME/.local/bin",
      "$HOME/.local/share/uv",
      "$HOME/.agents/skills",
      "$NONO_PACKAGES",
      "$NONO_CONFIG/profiles"
    ],
    "write": [
      "~/.local/share/uv/tools/mistral-vibe"
    ]
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "credentials": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {
      "mistral": {
        "upstream": "https://api.mistral.ai/v1",
        "credential_key": "MISTRAL_API_KEY",
        "auth": null,
        "inject_mode": "header",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}",
        "path_pattern": null,
        "path_replacement": null,
        "query_param_name": null,
        "proxy": null,
        "env_var": "MISTRAL_API_KEY",
        "endpoint_rules": [],
        "endpoint_policy": null,
        "tls_ca": null,
        "tls_client_cert": null,
        "tls_client_key": null,
        "aws_auth": null,
        "spiffe": null,
        "rate_limit": null
      }
    },
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "workdir": {
    "access": "readwrite"
  },
  "open_urls": {
    "allow_origins": [
      "https://api.mistral.ai",
      "https://console.mistral.ai"
    ],
    "allow_localhost": true
  },
  "allow_launch_services": true,
  "rollback": {
    "exclude_patterns": ["node_modules", ".next", "__pycache__", "target", ".vibe"],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  },
  "command_args": [],
  "unsafe_macos_seatbelt_rules": []
}
