{
  "extends": "default",
  "meta": {
    "name": "goose",
    "version": "1.0.0",
    "description": "Goose CLI agent",
    "author": "nolabs-ai"
  },
  "groups": {
    "include": [
      { "name": "user_caches_macos", "when": "macos" },
      { "name": "user_caches_linux", "when": "linux" },
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      { "name": "linux_sysfs_read", "when": "linux" },
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ]
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$HOME/.agents",
      "$HOME/.config/goose",
      "$HOME/.cache/goose",
      "$HOME/.local/share/goose",
      "$HOME/.local/state/goose",
      "$NONO_CONFIG/profile-drafts",
      "/tmp/goose-$UID",
      { "path": "$HOME/Library/Application Support/goose", "when": "macos" },
      { "path": "$HOME/Library/Caches/goose", "when": "macos" },
      { "path": "$HOME/Library/Logs/goose", "when": "macos" },
      { "path": "$HOME/Library/Keychains", "when": "macos" }
    ],
    "read_file": [
      { "path": "$HOME/Library/Keychains/login.keychain-db", "when": "macos" }
    ],
    "read": [
      "$NONO_PACKAGES",
      "$NONO_CONFIG/profiles"
    ],
    "bypass_protection": [
      { "path": "$HOME/Library/Keychains", "when": "macos" },
      { "path": "$HOME/Library/Keychains/login.keychain-db", "when": "macos" }
    ]
  },
  "network": {
    "block": false
  },
  "workdir": {
    "access": "readwrite"
  },
  "open_urls": {
    "allow_origins": [
      "https://api.anthropic.com",
      "https://api.openai.com",
      "https://auth.openai.com",
      "https://generativelanguage.googleapis.com",
      "https://openrouter.ai",
      "https://console.groq.com",
      "https://api.mistral.ai"
    ],
    "allow_localhost": true
  },
  "allow_launch_services": true,
  "environment": {
    "set_vars": {
      "GOOSE_MOIM_MESSAGE_TEXT": "You are running inside a nono security sandbox (kernel-enforced, Landlock/Seatbelt). Only the working directory and paths granted by the active nono profile are accessible. An 'Operation not permitted' or 'Permission denied' error on a path outside that scope is a nono sandbox denial, not a missing file or a bug: do not retry, use sudo, change permissions, or look for workarounds, because nothing inside the session can lift it. Tell the user which path or capability was blocked and that they can grant it by restarting Goose with e.g. `nono run --profile nolabs-ai/goose --read <path> -- goose` (use --allow for read+write), or by updating the nono profile. Load the nono-sandbox skill for more detail."
    }
  },
  "rollback": {
    "exclude_patterns": [
      "node_modules",
      ".next",
      "__pycache__",
      "target"
    ],
    "exclude_globs": [
      "*.tmp.[0-9]*.[0-9]*"
    ]
  }
}
