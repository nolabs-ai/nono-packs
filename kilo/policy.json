{
  "extends": "default",
  "meta": {
    "name": "kilo",
    "version": "1.0.0",
    "description": "Kilo Code CLI agent profile (registry-managed)",
    "author": "nolabs-ai"
  },
  "groups": {
    "include": [
      { "name": "user_caches_macos", "when": "macos" },
      { "name": "user_caches_linux", "when": "linux" },
      "node_runtime",
      "rust_runtime",
      "python_runtime",
      { "name": "linux_sysfs_read", "when": "linux" },
      "nix_runtime",
      "git_config",
      "unlink_protection"
    ]
  },
  "security": {
    "signal_mode": "isolated",
    "capability_elevation": false
  },
  "filesystem": {
    "allow": [
      "$HOME/.config/kilo",
      "$HOME/.local/share/kilo",
      "$HOME/.local/state/kilo",
      "$HOME/.cache/kilo/bin",
      "$NONO_CONFIG/profile-drafts",
      { "path": "$HOME/Library/Keychains", "when": "macos" },
      { "path": "$HOME/.local/state", "when": "macos" }
    ],
    "allow_file": [
      "$HOME/kilo.json"
    ],
    "read": [
      "$NONO_PACKAGES",
      "$NONO_CONFIG/profiles",
      "$HOME/.kilo/bin"
    ],
    "bypass_protection": [
      { "path": "$HOME/Library/Keychains", "when": "macos" }
    ]
  },
  "allow_parent_of_protected": true,
  "network": {
    "block": false
  },
  "workdir": { "access": "readwrite" },
  "open_urls": {
    "allow_origins": [],
    "allow_localhost": true
  },
  "allow_launch_services": true,
  "undo": {
    "exclude_patterns": ["node_modules", ".next", "__pycache__", "target", ".kilo"],
    "exclude_globs": ["*.tmp.[0-9]*.[0-9]*"]
  },
  "interactive": true
}
